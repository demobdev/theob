# Copy to .env.local (gitignored). Do not commit real secrets.
# =============================================================================
# Vercel CI only (do not commit) — generate with:
#   npx convex@latest deployment token create vercel --deployment quiet-mole-11 --save-env .env.local
# Add the same value in Vercel → Settings → Environment Variables as CONVEX_DEPLOY_KEY
# =============================================================================
# CONVEX_DEPLOY_KEY=dev:quiet-mole-11|...
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# =============================================================================
# Convex BACKEND secrets — NOT in this file for production.
# Set in: https://dashboard.convex.dev → your deployment → Environment Variables
# Or: npx convex env set KEY "value"
# See convex/ENV_KEYS.md
# =============================================================================
# CLERK_ISSUER_URL=https://your-clerk-frontend-api.clerk.accounts.dev
#
# Genius / Xenial POS (server-only — when Hector provides sandbox):
# GENIUS_API_BASE_URL=
# GENIUS_INTEGRATOR_TOKEN=
# GENIUS_SITE_ID=
# GENIUS_WEBHOOK_SECRET=
#
# Optional sports / AI:
# API_SPORTS_KEY=
# OPENAI_API_KEY=
