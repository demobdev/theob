# Copy to .env.local (gitignored). Do not commit real secrets.
# =============================================================================
# Vercel CI — required for successful builds
# =============================================================================
# NEXT_PUBLIC_CONVEX_URL (required) — set in Vercel for Production + Preview:
#   https://quiet-mole-11.convex.cloud
#
# CONVEX_DEPLOY_KEY (optional) — pushes Convex functions during Vercel build.
# Generate in Convex Dashboard → your deployment → Settings →
#   "Generate Production Deploy Key" (must NOT be read-only).
# If deploy fails with ViewData permission errors, regenerate the key or run
# `npx convex deploy` locally after backend changes.
# =============================================================================
# CONVEX_DEPLOY_KEY=prod:your-deployment|...
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# =============================================================================
# Convex BACKEND secrets — NOT in this file for production.
# Set in: https://dashboard.convex.dev → your deployment → Environment Variables
# Or: npx convex env set KEY "value"
# See convex/ENV_KEYS.md
# =============================================================================
# CLERK_ISSUER_URL=https://your-clerk-frontend-api.clerk.accounts.dev
#
# Genius / Xenial POS (server-only — when Hector provides sandbox):
# GENIUS_API_BASE_URL=
# GENIUS_INTEGRATOR_TOKEN=
# GENIUS_SITE_ID=
# GENIUS_WEBHOOK_SECRET=
#
# Optional sports / AI:
# API_SPORTS_KEY=
# OPENAI_API_KEY=
