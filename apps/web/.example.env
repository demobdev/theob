# Copy to .env.local and fill values. Run `npm run sync:env` from repo root after `npx convex dev`.

# Required
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional
# Heartland online ordering (browse menu on site; order via this URL)
NEXT_PUBLIC_HEARTLAND_ORDER_URL=
# DoorDash store page (delivery)
NEXT_PUBLIC_DOORDASH_STORE_URL=
# Shopify headless shop (Storefront API token is server-only)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
NEXT_PUBLIC_SHOPIFY_PRODUCT_HANDLES=the-ob-crew-tee,the-ob-quarter-zip
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=
