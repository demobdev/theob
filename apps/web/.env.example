# Copy to apps/web/.env.local
NEXT_PUBLIC_CONVEX_URL=https://quiet-mole-11.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Heartland online ordering (Hector may update subdomain)
NEXT_PUBLIC_HEARTLAND_SUBDOMAIN=theownersbox
NEXT_PUBLIC_HEARTLAND_ORDER_URL=https://theownersbox.retail.heartland.us
NEXT_PUBLIC_HEARTLAND_API_URL=https://theownersbox.retail.heartland.us/api/

# Hero background video — drop hero.mp4 in apps/web/public/ or set a hosted URL
NEXT_PUBLIC_HERO_VIDEO_URL=/hero.mp4

# App store links (optional until apps are live)
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=

# PostHog — https://us.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project
SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project
