# Copy to apps/native/.env.local
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# PostHog — https://us.posthog.com/project/settings
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — https://sentry.io → Project Settings → DSN
EXPO_PUBLIC_SENTRY_DSN=https://your_key@your_org.ingest.sentry.io/your_project

# Genius keys do NOT go here — POS runs on Convex server only.
