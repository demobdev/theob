{
  "cli": {
    "version": ">= 9.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "node": "20.18.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_ORG": "wvfm-labs",
        "SENTRY_PROJECT": "ob"
      }
    },
    "production": {
      "node": "20.18.0",
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "SENTRY_ORG": "wvfm-labs",
        "SENTRY_PROJECT": "ob"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal"
      }
    },
    "preview": {
      "android": {
        "track": "internal"
      }
    }
  }
}
